{
  "info": {
    "_postman_id": "6f3d0d52-3a8e-4f43-9d1e-4c1f7b2a9e10",
    "name": "Lettuce API",
    "description": "Black-box tests for the Lettuce Express API (api/). Status tables: brain/endpoints.md.\n\nRun the whole collection top to bottom: \"Auth / Sign in\" refreshes the token, and later folders use ids saved by earlier ones (Events needs group_id from Groups).\n\nRuns against the real Supabase project as the test user, so each run creates one group, one event and two busy blocks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Runs after every request. API errors must use the { error: string } contract (brain/api.md).",
          "// Supabase Auth's own errors have a different shape, so the sign-in request is skipped.",
          "if (pm.response.code >= 400 && !pm.request.url.getPath().startsWith(\"/auth/v1/\")) {",
          "  pm.test(\"error body is { error: string }\", () => pm.expect(pm.response.json().error).to.be.a(\"string\"));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign in",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.environment.set(\"access_token\", body.access_token);",
                  "pm.environment.set(\"user_id\", body.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "description": "Signs the test user in through Supabase Auth and saves the access token. Every request below inherits it from the collection's Bearer auth.",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{supabase_url}}/auth/v1/token?grant_type=password",
              "host": [
                "{{supabase_url}}"
              ],
              "path": [
                "auth",
                "v1",
                "token"
              ],
              "query": [
                {
                  "key": "grant_type",
                  "value": "password"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Profiles",
      "item": [
        {
          "name": "200 returns caller profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "pm.test(\"returns the caller's own profile\", () => {",
                  "  pm.expect(pm.response.json().id).to.eql(pm.environment.get(\"user_id\"));",
                  "});",
                  "",
                  "pm.test(\"body has exactly the Profile fields\", () => {",
                  "  pm.expect(pm.response.json()).to.have.all.keys(\"id\", \"username\", \"full_name\", \"avatar_url\", \"created_at\");",
                  "});",
                  "",
                  "// The PATCH request below sends these values back, so the run leaves the profile unchanged.",
                  "pm.environment.set(\"profile\", JSON.stringify(pm.response.json()));"
                ]
              }
            }
          ],
