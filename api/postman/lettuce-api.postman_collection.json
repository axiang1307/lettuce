                  "pm.test(\"blank description is stored as null\", () => pm.expect(group.description).to.be.null);",
                  "pm.test(\"not archived\", () => pm.expect(group.archived_at).to.be.null);",
                  "pm.test(\"body has exactly the Group fields\", () => pm.expect(group).to.have.all.keys(\"id\", \"name\", \"description\", \"created_by\", \"created_at\", \"archived_at\"));"
