    {
      "name": "Busy blocks",
      "item": [
        {
          "name": "201 creates one-off block",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "",
                  "const block = pm.response.json();",
                  "pm.environment.set(\"one_off_block_id\", block.id);",
                  "",
                  "pm.test(\"times come back as HH:MM:SS\", () => {",
                  "  pm.expect(block.start_time).to.eql(\"09:00:00\");",
                  "  pm.expect(block.end_time).to.eql(\"10:30:00\");",
                  "});",
                  "pm.test(\"one-off: no repeat_days, no end_date\", () => {",
                  "  pm.expect(block.repeat_days).to.be.null;",
                  "  pm.expect(block.end_date).to.be.null;",
                  "});",
                  "pm.test(\"start_date comes back as YYYY-MM-DD\", () => pm.expect(block.start_date).to.eql(\"2026-10-05\"));",
                  "pm.test(\"body has exactly the BusyBlock fields\", () => pm.expect(block).to.have.all.keys(\"id\", \"calendar_id\", \"start_date\", \"end_date\", \"start_time\", \"end_time\", \"repeat_days\", \"timezone\", \"created_at\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/busy-blocks",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "busy-blocks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start_date\": \"2026-10-05\",\n  \"start_time\": \"09:00\",\n  \"end_time\": \"10:30\",\n  \"timezone\": \"America/New_York\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Adds a real block to the test user's manual calendar on every run."
          }
        },
        {
          "name": "201 creates weekly block",
          "event": [
            {
