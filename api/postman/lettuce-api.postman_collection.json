            "body": {
              "mode": "raw",
              "raw": "{{patch_body}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Sends the profile's current full_name and username back (username padded with spaces), so the update path runs without changing the test user."
