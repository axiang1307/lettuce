    {
      "name": "Events",
      "item": [
        {
          "name": "201 creates event",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "",
                  "const event = pm.response.json();",
                  "pm.environment.set(\"event_id\", event.id);",
                  "",
                  "pm.test(\"caller is the creator\", () => pm.expect(event.created_by).to.eql(pm.environment.get(\"user_id\")));",
                  "pm.test(\"in the requested group\", () => pm.expect(event.group_id).to.eql(pm.environment.get(\"group_id\")));",
                  "pm.test(\"title is trimmed\", () => pm.expect(event.title).to.eql(\"Postman event\"));",
                  "pm.test(\"blank final_location and missing description are null\", () => {",
                  "  pm.expect(event.final_location).to.be.null;",
                  "  pm.expect(event.description).to.be.null;",
                  "});",
                  "pm.test(\"starts in planning with no final time\", () => {",
                  "  pm.expect(event.status).to.eql(\"planning\");",
                  "  pm.expect(event.final_starts_at).to.be.null;",
                  "  pm.expect(event.final_ends_at).to.be.null;",
                  "});",
                  "pm.test(\"body has exactly the Event fields\", () => pm.expect(event).to.have.all.keys(\"id\", \"group_id\", \"title\", \"description\", \"final_location\", \"final_starts_at\", \"final_ends_at\", \"status\", \"created_by\", \"created_at\", \"updated_at\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
