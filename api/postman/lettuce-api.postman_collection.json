        {
          "name": "200 updates profile (no-op, trims username)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Built from the profile saved by \"200 returns caller profile\".",
                  "const p = JSON.parse(pm.environment.get(\"profile\"));",
                  "const body = { full_name: p.full_name };",
                  "if (p.username) body.username = \"  \" + p.username + \"  \";",
                  "pm.variables.set(\"patch_body\", JSON.stringify(body));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const before = JSON.parse(pm.environment.get(\"profile\"));",
                  "const after = pm.response.json();",
                  "",
                  "pm.test(\"updates the caller's own profile\", () => pm.expect(after.id).to.eql(pm.environment.get(\"user_id\")));",
                  "pm.test(\"full_name is unchanged\", () => pm.expect(after.full_name).to.eql(before.full_name));",
                  "pm.test(\"username is trimmed\", () => pm.expect(after.username).to.eql(before.username));",
                  "pm.test(\"body has exactly the Profile fields\", () => pm.expect(after).to.have.all.keys(\"id\", \"username\", \"full_name\", \"avatar_url\", \"created_at\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/profiles/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "profiles",
                "me"
              ]
