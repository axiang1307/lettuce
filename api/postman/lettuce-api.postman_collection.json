                  "pm.environment.set(\"weekly_block_id\", block.id);",
                  "",
                  "pm.test(\"repeat_days are deduplicated and sorted\", () => pm.expect(block.repeat_days).to.eql([1, 3]));",
                  "pm.test(\"end_date comes back as YYYY-MM-DD\", () => pm.expect(block.end_date).to.eql(\"2026-12-31\"));"
                ]
              }
            }
